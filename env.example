DATABASE_URL=
LINE_MODE=live
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_ADMIN_USER_ID=
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=
LATE_GRACE_MINUTES=10
CHECKOUT_GRACE_MINUTES=15
CHECKIN_EARLY_MINUTES=60
BINDING_LINK_MINUTES=60
NOTIFICATION_RETRY_COOLDOWN_MINUTES=15
SEED_DEMO_DATA=false
ADMIN_USER=admin
ADMIN_PASSWORD=

# 主總表自動同步（Google Drive 私有 XLSX／Google 試算表）
MASTER_SYNC_ENABLED=true
MASTER_SYNC_PROVIDER=google_drive
# google_sheets 也可使用；程式會自動視為 google_drive 來源處理
MASTER_SYNC_INTERVAL_MINUTES=10
MASTER_SYNC_ON_STARTUP=true
MASTER_SYNC_MAX_MB=20
GOOGLE_DRIVE_FILE_ID=
# 建議使用 Base64，避免 Render Environment 的多行 JSON 問題
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
