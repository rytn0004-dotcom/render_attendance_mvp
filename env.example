# Render Environment Variables｜V0.4.6
DATABASE_URL=由 Render PostgreSQL 注入
LINE_MODE=live
LINE_CHANNEL_ACCESS_TOKEN=你的 Messaging API Channel Access Token
LINE_CHANNEL_SECRET=你的 Messaging API Channel Secret
LINE_ADMIN_USER_ID=管理員 LINE User ID
LINE_LOGIN_CHANNEL_ID=LINE Login Channel ID（與 Messaging API 放同一 Provider）
LIFF_ID=LINE Login Channel 的 LIFF ID
BINDING_LINK_MINUTES=60
LATE_GRACE_MINUTES=10
CHECKOUT_GRACE_MINUTES=15
CHECKIN_EARLY_MINUTES=60
PUBLIC_BASE_URL=https://你的Render網域
ADMIN_USER=admin
ADMIN_PASSWORD=請自行設定強密碼
